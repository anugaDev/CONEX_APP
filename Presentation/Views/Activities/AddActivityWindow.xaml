<Window x:Class="CONEX_APP.Presentation.Views.Activities.AddActivityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="760" Width="440" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Nombre de la Actividad:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

                <TextBlock Text="Tutor:" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding Tutors}" SelectedItem="{Binding SelectedTutor, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="FullName" Margin="0,0,0,10" Padding="5"/>

                <TextBlock Text="Aula:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Classroom, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

                <TextBlock Text="Máx. Alumnos:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding MaxStudents, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

                <TextBlock Text="Día y Hora:" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <ComboBox ItemsSource="{Binding DaysOfWeek}" SelectedItem="{Binding SelectedDay}" Width="150" Margin="0,0,10,0" Padding="5"/>
                    <ComboBox ItemsSource="{Binding Times}" SelectedItem="{Binding SelectedTime}" Width="100" Padding="5"/>
                </StackPanel>

                <!-- Alumnos (solo al editar: una clase nueva aún no tiene alumnos) -->
                <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Alumnos Apuntados:" FontSize="11" Foreground="Gray"/>
                        <TextBlock Text="{Binding OccupancyText, StringFormat=' ({0})'}" FontSize="11" Foreground="Gray" FontWeight="Bold"/>
                    </StackPanel>

                    <Grid Height="120" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ListBox Grid.Column="0"
                                 ItemsSource="{Binding EnrolledStudents}"
                                 SelectedItem="{Binding SelectedEnrolledStudent, Mode=TwoWay}"
                                 DisplayMemberPath="FullName"
                                 Margin="0,0,6,0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                        <Button Grid.Column="1"
                                Content="✖ Quitar&#x0a;alumno"
                                Command="{Binding RemoveStudentCommand}"
                                Width="70"
                                VerticalAlignment="Stretch"
                                Background="#CC3300"
                                Foreground="White"
                                FontSize="11"
                                FontWeight="Bold"
                                Padding="4"/>
                    </Grid>

                    <!-- Lista de espera -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="⏳ Lista de espera:" FontSize="11" FontWeight="Bold" Foreground="#B8860B" VerticalAlignment="Center"/>
                        <TextBlock Text=" (por orden de solicitud)" FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Height="110" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ListBox Grid.Column="0"
                                 ItemsSource="{Binding WaitlistEntries}"
                                 SelectedItem="{Binding SelectedWaitlistEntry, Mode=TwoWay}"
                                 Margin="0,0,6,0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Background="#FFFDF0"
                                 BorderBrush="#B8860B">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding PositionLabel}" FontWeight="Bold" Foreground="#B8860B" Margin="0,0,8,0" Width="25"/>
                                        <TextBlock Text="{Binding FullName}"/>
                                        <TextBlock Text="{Binding JoinedAt, StringFormat='  ({0:dd/MM/yyyy})'}" Foreground="Gray" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Grid.Column="1"
                                Content="✖ Quitar&#x0a;de lista"
                                Command="{Binding RemoveFromWaitlistCommand}"
                                Width="70"
                                VerticalAlignment="Stretch"
                                Background="#8B6914"
                                Foreground="White"
                                FontSize="11"
                                FontWeight="Bold"
                                Padding="4"/>
                    </Grid>

                    <TextBlock Text="Apuntar a la lista de espera (escribe para buscar):" FontSize="11" Foreground="Gray" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding WaitlistCandidates}"
                                  SelectedItem="{Binding SelectedWaitlistCandidate, Mode=TwoWay}"
                                  DisplayMemberPath="FullName"
                                  TextSearch.TextPath="FullName"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  StaysOpenOnEdit="True"
                                  Margin="0,0,6,0"
                                  Padding="5"/>
                        <Button Grid.Column="1"
                                Content="➕ Añadir"
                                Command="{Binding AddToWaitlistCommand}"
                                Width="70"
                                Background="#B8860B"
                                Foreground="White"
                                FontSize="11"
                                FontWeight="Bold"
                                Padding="4"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Cerrar" Command="{Binding CancelCommand}" Width="80" Margin="0,0,10,0" Padding="5"
                    ToolTip="Cierra sin guardar los datos de la clase (los cambios de alumnos y lista de espera ya están guardados)"/>
            <Button Content="Guardar" Command="{Binding SaveCommand}" Width="80" Padding="5" Background="#007ACC" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
