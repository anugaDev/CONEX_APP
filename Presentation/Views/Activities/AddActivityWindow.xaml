<Window x:Class="CONEX_APP.Presentation.Views.Activities.AddActivityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Añadir Nueva Actividad" Height="700" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Nombre de la Actividad:" Margin="0,0,0,5"/>
        <TextBox Grid.Row="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

        <TextBlock Grid.Row="2" Text="Tutor:" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="3" ItemsSource="{Binding Tutors}" SelectedItem="{Binding SelectedTutor, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="FullName" Margin="0,0,0,10" Padding="5"/>

        <TextBlock Grid.Row="4" Text="Aula:" Margin="0,0,0,5"/>
        <TextBox Grid.Row="5" Text="{Binding Classroom, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

        <TextBlock Grid.Row="6" Text="Máx. Alumnos:" Margin="0,0,0,5"/>
        <TextBox Grid.Row="7" Text="{Binding MaxStudents, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

        <TextBlock Grid.Row="8" Text="Día y Hora:" Margin="0,0,0,5"/>
        <StackPanel Grid.Row="9" Orientation="Horizontal" Margin="0,0,0,15">
            <ComboBox ItemsSource="{Binding DaysOfWeek}" SelectedItem="{Binding SelectedDay}" Width="150" Margin="0,0,10,0" Padding="5"/>
            <ComboBox ItemsSource="{Binding Times}" SelectedItem="{Binding SelectedTime}" Width="100" Padding="5"/>
        </StackPanel>

        <TextBlock Grid.Row="10" Text="Alumnos Apuntados:" Margin="0,0,0,5" FontSize="11" Foreground="Gray"/>

        <Grid Grid.Row="11" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0"
                     ItemsSource="{Binding EnrolledStudents}"
                     SelectedItem="{Binding SelectedEnrolledStudent, Mode=TwoWay}"
                     DisplayMemberPath="FullName"
                     Margin="0,0,6,0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>

            <Button Grid.Column="1"
                    Content="✖ Quitar&#x0a;alumno"
                    Command="{Binding RemoveStudentCommand}"
                    Width="70"
                    VerticalAlignment="Stretch"
                    Background="#CC3300"
                    Foreground="White"
                    FontSize="11"
                    FontWeight="Bold"
                    Padding="4"/>
        </Grid>

        <StackPanel Grid.Row="12" Orientation="Horizontal" Margin="0,0,0,5"
                    Visibility="{Binding HasWaitlistEntries, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="⏳ Lista de espera:" FontSize="11" FontWeight="Bold" Foreground="#B8860B" VerticalAlignment="Center"/>
            <TextBlock Text=" (por orden de solicitud)" FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="13" Margin="0,0,0,10"
              Visibility="{Binding HasWaitlistEntries, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0"
                     ItemsSource="{Binding WaitlistEntries}"
                     SelectedItem="{Binding SelectedWaitlistEntry, Mode=TwoWay}"
                     Margin="0,0,6,0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Background="#FFFDF0"
                     BorderBrush="#B8860B">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PositionLabel}" FontWeight="Bold" Foreground="#B8860B" Margin="0,0,8,0" Width="25"/>
                            <TextBlock Text="{Binding FullName}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Grid.Column="1"
                    Content="✖ Quitar&#x0a;de lista"
                    Command="{Binding RemoveFromWaitlistCommand}"
                    Width="70"
                    VerticalAlignment="Stretch"
                    Background="#8B6914"
                    Foreground="White"
                    FontSize="11"
                    FontWeight="Bold"
                    Padding="4"/>
        </Grid>

        <StackPanel Grid.Row="14" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Cancelar" Command="{Binding CancelCommand}" Width="80" Margin="0,0,10,0" Padding="5"/>
            <Button Content="Guardar" Command="{Binding SaveCommand}" Width="80" Padding="5" Background="#007ACC" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
