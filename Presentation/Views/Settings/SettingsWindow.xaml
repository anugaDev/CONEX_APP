<Window x:Class="CONEX_APP.Presentation.Views.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚙️ Ajustes de la Aplicación"
        Width="520" Height="400"
        MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F5F5F5">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0"
                   Text="Configuración General"
                   FontSize="20" FontWeight="Bold"
                   Foreground="#1A1A2E"
                   Margin="0,0,0,20"/>

        <!-- Campos -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">

            <!-- Período de renovación -->
            <TextBlock Text="Período de renovación (meses)"
                       FontSize="13" FontWeight="SemiBold" Foreground="#333"
                       Margin="0,0,0,4"/>
            <TextBox Text="{Binding RenewalPeriodMonths, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6" FontSize="14" Margin="0,0,0,14"
                     BorderBrush="#AAAAAA" BorderThickness="1"/>

            <!-- Coste de renovación -->
            <TextBlock Text="Coste de renovación (€)"
                       FontSize="13" FontWeight="SemiBold" Foreground="#333"
                       Margin="0,0,0,4"/>
            <TextBox Text="{Binding RenewalCost, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                     Padding="8,6" FontSize="14" Margin="0,0,0,14"
                     BorderBrush="#AAAAAA" BorderThickness="1"/>

            <!-- Coste por clase -->
            <TextBlock Text="Coste por clase (€)"
                       FontSize="13" FontWeight="SemiBold" Foreground="#333"
                       Margin="0,0,0,4"/>
            <TextBox Text="{Binding ClassCost, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                     Padding="8,6" FontSize="14"
                     BorderBrush="#AAAAAA" BorderThickness="1"/>
        </StackPanel>

        <!-- Mensaje de estado -->
        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   FontSize="12" Foreground="#1B7A3E"
                   Margin="0,10,0,6"
                   TextWrapping="Wrap"/>

        <!-- Botones -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar"
                    Command="{Binding CloseCommand}"
                    Width="100" Padding="10,6" Margin="0,0,10,0"
                    Background="#E0E0E0" Foreground="#333"/>
            <Button Content="💾 Guardar"
                    Command="{Binding SaveCommand}"
                    Width="120" Padding="10,6"
                    Background="#007ACC" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
