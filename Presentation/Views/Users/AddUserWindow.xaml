<Window x:Class="CONEX_APP.Presentation.Views.Users.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Añadir Nuevo Usuario" Height="500" Width="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="TextBoxNormal" TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#ABADB3"/>
        </Style>

        <!-- Estilo dinámico para campo Nombre -->
        <Style x:Key="NameTextBox" TargetType="TextBox" BasedOn="{StaticResource TextBoxNormal}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasNameError}" Value="True">
                    <Setter Property="BorderBrush" Value="#CC0000"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo dinámico para campo Surname -->
        <Style x:Key="SurnameTextBox" TargetType="TextBox" BasedOn="{StaticResource TextBoxNormal}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSurnameError}" Value="True">
                    <Setter Property="BorderBrush" Value="#CC0000"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo dinámico para campo IdCard -->
        <Style x:Key="IdCardTextBox" TargetType="TextBox" BasedOn="{StaticResource TextBoxNormal}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasIdCardError}" Value="True">
                    <Setter Property="BorderBrush" Value="#CC0000"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo dinámico para campo Email -->
        <Style x:Key="EmailTextBox" TargetType="TextBox" BasedOn="{StaticResource TextBoxNormal}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasEmailError}" Value="True">
                    <Setter Property="BorderBrush" Value="#CC0000"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel Margin="0,0,10,0">
                <!-- Nombre (obligatorio) -->
                <TextBlock Text="Nombre: *" Margin="0,0,0,5"/>
                <TextBox Style="{StaticResource NameTextBox}"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,2"/>
                <TextBlock Text="{Binding NameError}"
                           Foreground="#CC0000"
                           FontSize="11"
                           Margin="0,0,0,8"
                           Visibility="{Binding HasNameError, Converter={StaticResource BoolToVis}}"/>

                <!-- Primer Apellido (obligatorio) -->
                <TextBlock Text="Primer Apellido: *" Margin="0,0,0,5"/>
                <TextBox Style="{StaticResource SurnameTextBox}"
                         Text="{Binding Surname, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,2"/>
                <TextBlock Text="{Binding SurnameError}"
                           Foreground="#CC0000"
                           FontSize="11"
                           Margin="0,0,0,8"
                           Visibility="{Binding HasSurnameError, Converter={StaticResource BoolToVis}}"/>

                <!-- Segundo Apellido (opcional) -->
                <TextBlock Text="Segundo Apellido:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding SecondSurname, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

                <!-- DNI/NIF (obligatorio) -->
                <TextBlock Text="DNI / NIF: *" Margin="0,0,0,5"/>
                <TextBox Style="{StaticResource IdCardTextBox}"
                         Text="{Binding IdCard, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,2"/>
                <TextBlock Text="{Binding IdCardError}"
                           Foreground="#CC0000"
                           FontSize="11"
                           Margin="0,0,0,8"
                           Visibility="{Binding HasIdCardError, Converter={StaticResource BoolToVis}}"/>

                <!-- Teléfono (opcional) -->
                <TextBlock Text="Teléfono:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

                <!-- Correo Electrónico (obligatorio) -->
                <TextBlock Text="Correo Electrónico: *" Margin="0,0,0,5"/>
                <TextBox Style="{StaticResource EmailTextBox}"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,2"/>
                <TextBlock Text="{Binding EmailError}"
                           Foreground="#CC0000"
                           FontSize="11"
                           Margin="0,0,0,8"
                           Visibility="{Binding HasEmailError, Converter={StaticResource BoolToVis}}"/>

                <!-- Dirección (opcional) -->
                <TextBlock Text="Dirección:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

                <!-- Localidad (opcional) -->
                <TextBlock Text="Localidad:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15" Padding="5"/>

                <CheckBox Content="Es Socio" IsChecked="{Binding IsPartner}" Margin="0,0,0,10"/>
                <CheckBox Content="Es Tutor" IsChecked="{Binding IsTutor}" Margin="0,0,0,20"/>

                <TextBlock Text="Añadir a Clase/Actividad:" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding AvailableActivities}" SelectedItem="{Binding SelectedActivityToAdd, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Name" Margin="0,0,0,10" Padding="5"/>
                
                <TextBlock Text="Clases Apuntado:" Margin="0,0,0,5" FontSize="11" Foreground="Gray"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0"
                             ItemsSource="{Binding SelectedActivities}"
                             SelectedItem="{Binding SelectedActivityToRemove, Mode=TwoWay}"
                             DisplayMemberPath="Name"
                             Height="80"
                             Margin="0,0,5,0"/>
                    <Button Grid.Column="1"
                            Content="✖ Quitar&#x0a;de clase"
                            Command="{Binding RemoveActivityCommand}"
                            Width="70"
                            VerticalAlignment="Stretch"
                            Background="#CC3300"
                            Foreground="White"
                            FontSize="11"
                            FontWeight="Bold"
                            Padding="4"/>
                </Grid>

                <!-- Leyenda campos obligatorios -->
                <TextBlock Text="* Campos obligatorios" FontSize="10" Foreground="Gray" Margin="0,0,0,5"/>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Cancelar" Command="{Binding CancelCommand}" Width="80" Margin="0,0,10,0" Padding="5"/>
            <Button Content="Guardar" Command="{Binding SaveCommand}" Width="80" Padding="5" Background="#007ACC" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
