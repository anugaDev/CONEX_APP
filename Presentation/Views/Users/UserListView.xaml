<UserControl x:Class="CONEX_APP.Presentation.Views.Users.UserListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:CONEX_APP.Presentation.Converters">

    <UserControl.Resources>
        <converters:RenewalStatusToBackgroundConverter x:Key="RenewalStatusToBackground"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Atrás" Command="{Binding GoBackCommand}" Width="80" Padding="5" Margin="0,0,20,0"/>
                <TextBlock Text="Tabla de Usuarios" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Ir a Clases ➔" Command="{Binding GoToActivitiesCommand}" 
                    HorizontalAlignment="Right" Padding="15,5" 
                    Background="#28A745" Foreground="White" FontWeight="Bold"/>
        </Grid>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Añadir Nuevo Usuario" Command="{Binding OpenAddUserWindowCommand}" 
                    Padding="10,5" Margin="0,0,10,0" 
                    Background="#007ACC" Foreground="White" FontWeight="Bold"/>
                    
            <Button Content="Eliminar Usuario" Command="{Binding DeleteUserCommand}" 
                    Padding="10,5" Margin="0,0,10,0"
                    Background="#CC0000" Foreground="White" FontWeight="Bold"/>

            <Button Content="🔄 Renovar" Command="{Binding RenewUserCommand}"
                    Padding="10,5" Margin="0,0,10,0"
                    Background="#0D6E6E" Foreground="White" FontWeight="Bold"
                    ToolTip="Registra la renovación del usuario seleccionado con la fecha de hoy"/>
                    
            <Button Content="🪪 Imprimir Carnet" Command="{Binding PrintBadgeCommand}" 
                    Padding="10,5" Margin="0,0,10,0"
                    Background="#FF8C00" Foreground="White" FontWeight="Bold"/>
                    
            <Button Content="📋 Imprimir Hoja de Inscripción" Command="{Binding PrintRegistrationFormCommand}" 
                    Padding="10,5" Margin="0,0,10,0"
                    Background="#6A0DAD" Foreground="White" FontWeight="Bold"/>
                    
            <Button Content="🧾 Imprimir Recibo de Renovación" Command="{Binding PrintRenewalReceiptCommand}" 
                    Padding="10,5" Margin="0,0,10,0"
                    Background="#1B7A3E" Foreground="White" FontWeight="Bold"/>

            <Button Content="⚙️ Ajustes" Command="{Binding OpenSettingsCommand}"
                    Padding="10,5"
                    Background="#555555" Foreground="White" FontWeight="Bold"/>
        </StackPanel>

        <!-- Leyenda de colores + barra de búsqueda -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="14" Height="14" Background="#FFEB3B" BorderBrush="#CCC" BorderThickness="1" Margin="0,0,4,0"/>
                <TextBlock Text="Vence en ≤ 30 días" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Border Width="14" Height="14" Background="#FFCDD2" BorderBrush="#CCC" BorderThickness="1" Margin="0,0,4,0"/>
                <TextBlock Text="Vencido" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Column="1" Margin="16,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,4" FontSize="13"
                         ToolTip="Buscar por nombre, apellido, DNI, teléfono, correo..."/>
                <Button Grid.Column="1" Content="✕" Width="28"
                        Command="{Binding ClearSearchCommand}"
                        Padding="4" Margin="4,0,0,0"
                        ToolTip="Limpiar búsqueda"/>
            </Grid>
        </Grid>

        <DataGrid Grid.Row="3" ItemsSource="{Binding UsersView}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditUserCommand}" />
            </DataGrid.InputBindings>

            <!-- Estilo de fila: colorea el fondo según RenewalStatus usando el converter -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{Binding RenewalStatus, Converter={StaticResource RenewalStatusToBackground}}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#CCE5FF"/>
                            <Setter Property="BorderBrush" Value="#007ACC"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="100"/>
                <DataGridTextColumn Header="Primer Apellido" Binding="{Binding Surname}" Width="120"/>
                <DataGridTextColumn Header="Segundo Apellido" Binding="{Binding SecondSurname}" Width="120"/>
                <DataGridTextColumn Header="DNI" Binding="{Binding IdCard}" Width="90"/>
                <DataGridTextColumn Header="Teléfono" Binding="{Binding Phone}" Width="95"/>
                <DataGridTextColumn Header="Correo Electrónico" Binding="{Binding Email}" Width="150"/>
                <DataGridCheckBoxColumn Header="Socio" Binding="{Binding IsPartner}" Width="50"/>
                <DataGridCheckBoxColumn Header="Tutor" Binding="{Binding IsTutor}" Width="50"/>
                <DataGridTextColumn Header="Última Renovación"
                                    Binding="{Binding LastRenewalDate, StringFormat=dd/MM/yyyy, TargetNullValue='Sin renovaciones'}"
                                    Width="130"/>
                <DataGridTextColumn Header="Próxima Renovación"
                                    Binding="{Binding NextRenewalDate, StringFormat=dd/MM/yyyy}"
                                    Width="130"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
