<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Presentation\Resources\Images\conex_logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.4" />
    <PackageReference Include="QuestPDF" Version="2023.12.6" />
  </ItemGroup>

  <!--
    La base de datos NO se copia a bin\: vive en %LOCALAPPDATA%\CONEX (ver Infrastructure/Data/DatabasePaths.cs).
    El esquema va incrustado en el ejecutable.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Infrastructure\Data\Schema\schema.sql" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Presentation\Resources\Images\conex_logo.png" />
    <Resource Include="Presentation\Resources\Images\conex_logo.ico" />
  </ItemGroup>

</Project>
